# Copy to .env and fill in. .env is gitignored - never commit real keys.
ANTHROPIC_API_KEY=sk-ant-...

# --- model selection -------------------------------------------------------
# Registry keys defined in penny/infrastructure/config/models.py:
#   Anthropic API: opus5 | sonnet5 | haiku45
#   Local (no key, nothing leaves the machine): local-qwen3-4b | local-qwen3-8b | local-qwen25-7b
PENNY_MODEL_KEY=opus5
PENNY_GREETING_MODEL_KEY=opus5
PENNY_JUDGE_MODEL_KEY=haiku45
PENNY_ANALYST_MODEL_KEY=opus5

# --- local model endpoint (only used by local-* keys) ------------------------
# OpenAI-compatible server inside the deployment: Ollama on a laptop, vLLM in the VPC.
# Must be a loopback or private-network host; Ollama ":cloud" models are refused.
PENNY_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
PENNY_LOCAL_API_KEY=local
PENNY_LOCAL_ALLOW_PUBLIC_HOST=false

# Reasoning depth: low | medium | high | xhigh | max
PENNY_EFFORT=medium
# The opener only phrases pre-computed numbers, so it does not need depth.
PENNY_GREETING_EFFORT=low

# --- guards ----------------------------------------------------------------
# Model calls per request before the agent is forced to wrap up.
PENNY_MAX_MODEL_CALLS=8

# --- session ---------------------------------------------------------------
# Fixed TTL, never refreshed (seconds).
PENNY_SESSION_TTL_SECONDS=1800

# --- feature flags ---------------------------------------------------------
PENNY_ENABLE_GREETING=true
PENNY_ENABLE_AUDIT_LOG=true
PENNY_USE_HAIKU_FOR_GREETING=false

# --- data ------------------------------------------------------------------
PENNY_ENRICHED_PATH=data/transactions_enriched.json

# --- observability ---------------------------------------------------------
# Print OpenTelemetry spans to stdout (noisy; useful when demoing tracing).
PENNY_OTEL_CONSOLE=false
PENNY_AUDIT_LOG_PATH=data/audit_log.jsonl
PENNY_LOG_LEVEL=INFO
